if(NOT EXISTS "${DOL}")
    message(FATAL_ERROR "PAL DOL fixture missing")
endif()
file(SHA256 "${DOL}" actual_sha256)
if(NOT actual_sha256 STREQUAL "fde4fa6f81a60313b710161c196dc51c2260be62251ee02775d5eee06f9d55af")
    message(FATAL_ERROR "PAL GUPP8P DOL SHA-256 mismatch")
endif()
execute_process(COMMAND "${PROGRAM}" "${DOL}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "boot probe failed: ${error}")
endif()
if(MODE STREQUAL "probe")
    set(expected "STOP pc=0x80003158 lr=0x80003158 r1=0x8060C5F0 r2=0x805FA780 r13=0x805EC500\n")
elseif(MODE STREQUAL "regression")
    set(expected "PAL register-startup positive and negative gates passed\n")
else()
    message(FATAL_ERROR "unknown boot test mode")
endif()
if(NOT output STREQUAL expected)
    message(FATAL_ERROR "boot test output differs: ${output}")
endif()
