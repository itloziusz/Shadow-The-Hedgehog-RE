if(NOT EXISTS "${DOL}")
    message(FATAL_ERROR "PAL DOL fixture missing")
endif()
file(SHA256 "${DOL}" actual_sha256)
if(NOT actual_sha256 STREQUAL "fde4fa6f81a60313b710161c196dc51c2260be62251ee02775d5eee06f9d55af")
    message(FATAL_ERROR "PAL GUPP8P DOL SHA-256 mismatch")
endif()
set(arguments "${DOL}")
if(MODE STREQUAL "hle_prefix" OR MODE STREQUAL "hle_hid2_read" OR MODE STREQUAL "hle_hid0_request")
    list(APPEND arguments --observed-msr 00002032)
endif()
if(MODE STREQUAL "hle_hid2_read" OR MODE STREQUAL "hle_hid0_request")
    list(APPEND arguments --observed-hid2 E0000000)
endif()
if(MODE STREQUAL "hle_hid0_request")
    list(APPEND arguments --observed-hid0 0011C464)
endif()
execute_process(COMMAND "${PROGRAM}" ${arguments}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "boot probe failed: ${error}")
endif()
if(MODE STREQUAL "probe")
    set(expected "CHECKPOINT pc=0x80003158 lr=0x80003158\nSTOP pc=0x80003400 lr=0x8000315C r1=0x8060C5F0 r2=0x805FA780 r13=0x805EC500\n")
elseif(MODE STREQUAL "regression")
    set(expected "PAL register-startup positive and negative gates passed\n")
elseif(MODE STREQUAL "fpr_seed")
    set(expected "PAL FPR seed bounded projection and adversarial gates passed\n")
elseif(MODE STREQUAL "native_sync")
    set(expected "PAL connected native sync/FPR/cache-consumer gates passed; 166 raw-word mutations rejected\n")
elseif(MODE STREQUAL "loop")
    set(expected "PAL application recurring phase: event order verified\n")
elseif(MODE STREQUAL "hle_prefix")
    set(expected "CHECKPOINT pc=0x80003158 lr=0x80003158\nCHECKPOINT pc=0x80003400 lr=0x8000315C\nINPUT msr=0x00002032 provenance=CALLER_SUPPLIED\nCHECKPOINT pc=0x80371714 lr=0x80003414 r0=0x00002032 r31=0x8000315C msr=0x00002032\nWRITE addr=0x8060C5F4 value=0x80003414 width=4 endian=BE\nWRITE addr=0x8060C5E8 value=0x8060C5F0 width=4 endian=BE\nSTOP pc=0x80370BA8 lr=0x80371724 r0=0x80003414 r1=0x8060C5E8 r31=0x8000315C msr=0x00002032\n")
elseif(MODE STREQUAL "hle_hid2_read" OR MODE STREQUAL "hle_hid0_request")
    set(expected "CHECKPOINT pc=0x80003158 lr=0x80003158\nCHECKPOINT pc=0x80003400 lr=0x8000315C\nINPUT msr=0x00002032 provenance=CALLER_SUPPLIED\nCHECKPOINT pc=0x80371714 lr=0x80003414 r0=0x00002032 r31=0x8000315C msr=0x00002032\nWRITE addr=0x8060C5F4 value=0x80003414 width=4 endian=BE\nWRITE addr=0x8060C5E8 value=0x8060C5F0 width=4 endian=BE\nCHECKPOINT pc=0x80370BA8 lr=0x80371724 r0=0x80003414 r1=0x8060C5E8 r31=0x8000315C msr=0x00002032\nINPUT hid2=0xE0000000 provenance=CALLER_SUPPLIED\nCHECKPOINT pc=0x80371724 lr=0x80371724 r0=0x80003414 r1=0x8060C5E8 r3=0xE0000000 msr=0x00002032\nSPR_WRITE_REQUEST spr=920 value=0xE0000000\nSTOP pc=0x8037172C lr=0x8037172C r0=0x80003414 r1=0x8060C5E8 r3=0xE0000000 msr=0x00002032\n")
    if(MODE STREQUAL "hle_hid0_request")
        string(REPLACE "STOP pc=0x8037172C" "CHECKPOINT pc=0x8037172C" expected "${expected}")
        string(APPEND expected "INPUT hid0=0x0011C464 provenance=CALLER_SUPPLIED\nSPR_WRITE_REQUEST spr=1008 value=0x0011CC64\nSTOP pc=0x80371730 lr=0x80371730 r0=0x80003414 r1=0x8060C5E8 r3=0x0011CC64 msr=0x00002032\n")
    endif()
else()
    message(FATAL_ERROR "unknown boot test mode")
endif()
if(NOT output STREQUAL expected)
    message(FATAL_ERROR "boot test output differs: ${output}")
endif()
