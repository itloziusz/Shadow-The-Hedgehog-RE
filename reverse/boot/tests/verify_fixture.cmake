if(NOT EXISTS "${DOL}")
    message(FATAL_ERROR "PAL DOL fixture missing")
endif()
file(SHA256 "${DOL}" actual_sha256)
if(NOT actual_sha256 STREQUAL "fde4fa6f81a60313b710161c196dc51c2260be62251ee02775d5eee06f9d55af")
    message(FATAL_ERROR "PAL GUPP8P DOL SHA-256 mismatch")
endif()
set(arguments "${DOL}")
if(MODE STREQUAL "hle_prefix")
    list(APPEND arguments --observed-msr 00002032)
endif()
execute_process(COMMAND "${PROGRAM}" ${arguments}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "boot probe failed: ${error}")
endif()
if(MODE STREQUAL "probe")
    set(expected "CHECKPOINT pc=0x80003158 lr=0x80003158\nSTOP pc=0x80003400 lr=0x8000315C r1=0x8060C5F0 r2=0x805FA780 r13=0x805EC500\n")
elseif(MODE STREQUAL "regression")
    set(expected "PAL register-startup positive and negative gates passed\n")
elseif(MODE STREQUAL "loop")
    set(expected "PAL application recurring phase: event order verified\n")
elseif(MODE STREQUAL "hle_prefix")
    set(expected "CHECKPOINT pc=0x80003158 lr=0x80003158\nCHECKPOINT pc=0x80003400 lr=0x8000315C\nINPUT msr=0x00002032 provenance=CALLER_SUPPLIED\nSTOP pc=0x80371714 lr=0x80003414 r0=0x00002032 r31=0x8000315C msr=0x00002032\n")
else()
    message(FATAL_ERROR "unknown boot test mode")
endif()
if(NOT output STREQUAL expected)
    message(FATAL_ERROR "boot test output differs: ${output}")
endif()
